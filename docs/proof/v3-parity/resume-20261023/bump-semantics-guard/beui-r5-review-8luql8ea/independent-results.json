{
  "nontransparentWrapper": {
    "removed": [
      "focused-app"
    ],
    "focusPreserved": false,
    "order": [
      "focused-app",
      "app-owned-control"
    ]
  },
  "multiview": {
    "focusPreserved": true,
    "otherOrder": true
  },
  "shadowRoot": {
    "focusedBefore": true,
    "hostBefore": true,
    "activeElementIsHost": true,
    "focusPreserved": true
  },
  "undefined-reference": {
    "error": null,
    "returnsNode": true
  },
  "invalid-number": {
    "error": "TypeError",
    "returnsNode": false
  },
  "invalid-symbol": {
    "error": "TypeError",
    "returnsNode": false
  },
  "extra-argument": {
    "error": null,
    "returnsNode": true
  }
}