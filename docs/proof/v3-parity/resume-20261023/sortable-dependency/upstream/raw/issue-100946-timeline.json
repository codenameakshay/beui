879dd61ef7d.MP4\r\n\r\nI tried this on my iPad and it was more obvious.\r\n\r\nhttps://user-images.githubusercontent.com/8084530/160597526-45e17b34-bb89-4740-9e3c-b1a3aba3a761.MP4\r\n\r\n<details>\r\n<summary>Reorder Code</summary>\r\n\r\n```dart\r\nimport 'package:flutter/material.dart';\r\n\r\nvoid main() {\r\n  runApp(const MyApp());\r\n}\r\n\r\nclass MyApp extends StatelessWidget {\r\n  const MyApp({Key? key}) : super(key: key);\r\n\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return MaterialApp(\r\n      title: 'Reorder Test',\r\n      theme: ThemeData(primarySwatch: Colors.blue),\r\n      home: const MyHomePage(),\r\n    );\r\n  }\r\n}\r\n\r\nclass MyHomePage extends StatefulWidget {\r\n  const MyHomePage({Key? key}) : super(key: key);\r\n\r\n  @override\r\n  State<MyHomePage> createState() => _MyHomePageState();\r\n}\r\n\r\nclass _MyHomePageState extends State<MyHomePage> {\r\n  final _itemKeys = [for (var i = 0; i < 10; i++) ValueKey(i)];\r\n\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return Scaffold(\r\n      appBar: AppBar(\r\n          leading: IconButton(\r\n            icon: const Icon(Icons.arrow_back),\r\n            onPressed: () {},\r\n          ),\r\n          title: const Text('Reorder Test')),\r\n      body: ReorderableListView(\r\n        children: [\r\n          for (var key in _itemKeys)\r\n            ListTile(\r\n              key: key,\r\n              title: Text('Item ${key.value}'),\r\n            ),\r\n        ],\r\n        onReorder: (oldIndex, newIndex) {\r\n          final item = _itemKeys.removeAt(oldIndex);\r\n          _itemKeys.insert(newIndex - (newIndex > oldIndex ? 1 : 0), item);\r\n          setState(() {});\r\n        },\r\n      ),\r\n    );\r\n  }\r\n}\r\n```\r\n</details>","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/flutter/flutter/issues/comments/1081737141/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart"