team-accessibility","color":"198022"},"intent":null,"performed_via_github_app":null},{"url":"https://api.github.com/repos/flutter/flutter/issues/comments/6275493549","html_url":"https://github.com/flutter/flutter/issues/194636#issuecomment-6275493549","issue_url":"https://api.github.com/repos/flutter/flutter/issues/194636","id":6275493549,"node_id":"IC_kwDOAeUeuM8AAAABdgxurQ","user":{"login":"mbcorona","id":14170258,"node_id":"MDQ6VXNlcjE0MTcwMjU4","avatar_url":"https://avatars.githubusercontent.com/u/14170258?v=4","gravatar_id":"","url":"https://api.github.com/users/mbcorona","html_url":"https://github.com/mbcorona","followers_url":"https://api.github.com/users/mbcorona/followers","following_url":"https://api.github.com/users/mbcorona/following{/other_user}","gists_url":"https://api.github.com/users/mbcorona/gists{/gist_id}","starred_url":"https://api.github.com/users/mbcorona/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mbcorona/subscriptions","organizations_url":"https://api.github.com/users/mbcorona/orgs","repos_url":"https://api.github.com/users/mbcorona/repos","events_url":"https://api.github.com/users/mbcorona/events{/privacy}","received_events_url":"https://api.github.com/users/mbcorona/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-19T19:28:33Z","updated_at":"2026-10-19T19:28:33Z","body":"Hi @aerotech-vadb, thanks for the thorough trace. Confirmed on master: disable() nulls lastEditingState (text_field.dart:163) and enable() only restores it when it is non null (text_editing.dart:1993), so the re-created empty input is never corrected, which matches your steps 2 and 3.\n\nThis is in the same web semantics text field area as #194548 and #194186, but it is a distinct data loss rather than just an empty value exposed to AT, so keeping it separate. Routing to team-accessibility.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/flutter/flutt